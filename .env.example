# ── Environment ───────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── MongoDB Atlas ─────────────────────────────────────────────
# URL-encode special characters in your password before pasting:
#   @ → %40   '  → %27   # → %23   ! → %21
MONGODB_URI=mongodb+srv://<username>:<url-encoded-password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority&appName=<appName>

# ── Session ───────────────────────────────────────────────────
# Generate a strong random secret (min 32 chars)
SESSION_SECRET=replace-with-a-strong-random-secret

